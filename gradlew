##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh does
#       not find so, but you have some other compatible shell such as ksh or
#       bash, then to use that shell, have it execute this file, so that the
#       environment variables are set correctly.
#
#   (2) Go into the directory where you have the project files. You will then be
#       able to run the gradle wrapper directly like this: ./gradlew --version
#
#   Attention to Windows users: you should use the gradlew.bat file (with 'cmd.exe'
#   or PowerShell) or use Linux command line to run gradle wrapper.
#
##############################################################################

# shellcheck disable=SC2006
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_JAR="${APP_HOME}/gradle/wrapper/gradle-wrapper.jar"

# This is normally unused; let us know if you develop a faster workaround.
#GRADLE_OPTS="$GRADLE_OPTS -XX:+IgnoreUnrecognizedVMOptions -XX:+UseG1GC -XX:+UseStringDeduplication -XX:+ParallelRefProcEnabled -XX:+UnlockDiagnosticVMOptions -XX:G1SummarizeRSetStatsPeriod=1"

CLASSPATH=$APP_JAR

# Determine the Java command to use in order to create the classpath by
# interrogating the JAVA_HOME environment variable.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "Error: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        exit 1
    fi
else
    echo "Error: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
    exit 1
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $( ulimit -S -n ) in #(
      ''|soft) :;; #(
      *)
        ulimit -S -n 'unlimited' ;;
    esac
fi

if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )

    JAVACMD=$( cygpath --unix "$JAVACMD" )

    # Now convert the arguments - kludge to limit ourselves to /bin/sh
    for arg do
        if
            case $arg in                                #(
              -*)   false ;;                            # don't mess with options #(
              /?*)  t=${arg#/} t=/${t%%/*}              # looks like a POSIX filepath
                    [ -e "$t" ] ;;                      #(
              *)    false ;;
            esac
        then
            arg=$( cygpath --path --mixed "$arg" )
        fi
        appargs="$appargs '$arg'"
    done
    set -- $appargs
fi

# Apply sed if available, otherwise fall back to printf
if command -v sed >/dev/null; then
    APP_JAR=$( sed -e "s|$APP_HOME|.|g" <<< "$APP_JAR" )
fi

exec "$JAVACMD" \
  -Xmx64m \
  -Xms64m \
  -classpath "$CLASSPATH"  \
  org.gradle.wrapper.GradleWrapperMain \
  "$@"
